# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vudio?retryWrites=true&w=majority

# JWT Secrets — generate strong random strings (e.g. openssl rand -hex 64)
ACCESS_TOKEN_SECRET=change_this_to_a_strong_random_secret_min_64_chars
REFRESH_TOKEN_SECRET=change_this_to_another_strong_random_secret_min_64_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Client URL (CORS whitelist)
CLIENT_URL=http://localhost:3000

# AI
ANTHROPIC_API_KEY=sk-ant-api03-...
